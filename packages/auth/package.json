{
  "name": "@lingkod-hr/auth",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm --dir ../../apps/web exec tsx e2e/local-oidc.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@lingkod-hr/config": "workspace:*",
    "jose": "5.10.0",
    "otpauth": "9.5.2"
  },
  "devDependencies": {
    "@types/node": "24.13.3"
  }
}
