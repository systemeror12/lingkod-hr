generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

model Agency {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                    String   @unique @db.Citext
  name                    String
  acronym                 String?
  agencyType              String   @map("agency_type")
  status                  String
  defaultTimezone         String   @default("Asia/Manila") @map("default_timezone")
  defaultCurrency         String   @default("PHP") @map("default_currency") @db.Char(3)
  currentProfileVersionId String?  @map("current_profile_version_id") @db.Uuid
  rowVersion              Int      @default(1) @map("row_version")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  currentProfile                AgencyProfileVersion?          @relation("AgencyCurrentProfile", fields: [id, currentProfileVersionId], references: [agencyId, id], onDelete: Restrict, map: "agencies_current_profile_fkey")
  profiles                      AgencyProfileVersion[]         @relation("AgencyProfiles")
  memberships                   AgencyMembership[]
  invitations                   Invitation[]
  roles                         Role[]
  membershipRoles               MembershipRole[]
  delegatedAuthorities          DelegatedAuthority[]
  sessions                      UserSession[]
  securityEvents                SecurityEvent[]
  auditEvents                   AuditEvent[]
  organizationUnits             OrganizationUnit[]
  organizationUnitVersions      OrganizationUnitVersion[]
  documents                     Document[]
  documentVersions              DocumentVersion[]
  staffingAuthorities           StaffingAuthority[]
  qualificationStandards        QualificationStandard[]
  qualificationStandardVersions QualificationStandardVersion[]
  plantillaPositions            PlantillaPosition[]
  plantillaPositionVersions     PlantillaPositionVersion[]

  @@unique([id, code])
  @@map("agencies")
}

model AgencyProfileVersion {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId                 String    @map("agency_id") @db.Uuid
  versionNo                Int       @map("version_no")
  officialName             String    @map("official_name")
  acronym                  String?
  agencyType               String    @default("NGA") @map("agency_type")
  parentOrganization       String?   @map("parent_organization")
  reportingIdentifiers     String?   @map("reporting_identifiers")
  appointingAuthorityTitle String?   @map("appointing_authority_title")
  defaultTimezone          String    @default("Asia/Manila") @map("default_timezone")
  defaultCurrency          String    @default("PHP") @map("default_currency") @db.Char(3)
  deploymentProfile        String    @map("deployment_profile")
  effectiveFrom            DateTime  @map("effective_from") @db.Date
  effectiveTo              DateTime? @map("effective_to") @db.Date
  configuration            Json      @default("{}")
  status                   String
  domainStatus             String    @default("ACTIVE") @map("domain_status")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  agency             Agency   @relation("AgencyProfiles", fields: [agencyId], references: [id], onDelete: Restrict)
  currentForAgencies Agency[] @relation("AgencyCurrentProfile")

  @@unique([agencyId, versionNo])
  @@unique([agencyId, id])
  @@index([agencyId, effectiveFrom])
  @@map("agency_profile_versions")
}

model OrganizationUnit {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId         String   @map("agency_id") @db.Uuid
  code             String   @db.Citext
  unitType         String   @map("unit_type")
  status           String
  currentVersionId String?  @map("current_version_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  agency                    Agency                     @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  currentVersion            OrganizationUnitVersion?   @relation("OrganizationUnitCurrentVersion", fields: [agencyId, currentVersionId], references: [agencyId, id], onDelete: Restrict)
  versions                  OrganizationUnitVersion[]  @relation("OrganizationUnitVersions")
  childVersions             OrganizationUnitVersion[]  @relation("OrganizationUnitVersionParent")
  primaryMemberships        AgencyMembership[]         @relation("AgencyMembershipPrimaryUnit")
  plantillaPositionVersions PlantillaPositionVersion[] @relation("PlantillaPositionOrganizationUnit")

  @@unique([agencyId, id])
  @@unique([agencyId, code])
  @@map("organization_units")
}

model OrganizationUnitVersion {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId                 String    @map("agency_id") @db.Uuid
  organizationUnitId       String    @map("organization_unit_id") @db.Uuid
  versionNo                Int       @map("version_no")
  name                     String
  parentUnitId             String?   @map("parent_unit_id") @db.Uuid
  headPositionId           String?   @map("head_position_id") @db.Uuid
  costCenterCode           String?   @map("cost_center_code")
  responsibilityCenterCode String?   @map("responsibility_center_code")
  effectiveFrom            DateTime  @map("effective_from") @db.Date
  effectiveTo              DateTime? @map("effective_to") @db.Date
  status                   String
  domainStatus             String    @default("ACTIVE") @map("domain_status")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  agency           Agency             @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  organizationUnit OrganizationUnit   @relation("OrganizationUnitVersions", fields: [agencyId, organizationUnitId], references: [agencyId, id], onDelete: Restrict)
  currentForUnits  OrganizationUnit[] @relation("OrganizationUnitCurrentVersion")
  parentUnit       OrganizationUnit?  @relation("OrganizationUnitVersionParent", fields: [agencyId, parentUnitId], references: [agencyId, id], onDelete: Restrict)
  headPosition     PlantillaPosition? @relation("OrganizationUnitHead", fields: [agencyId, headPositionId], references: [agencyId, id], onDelete: Restrict)

  @@unique([organizationUnitId, versionNo])
  @@unique([agencyId, id])
  @@index([agencyId, parentUnitId, effectiveFrom])
  @@map("organization_unit_versions")
}

model User {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identityProvider String    @map("identity_provider")
  externalSubject  String    @map("external_subject")
  emailNormalized  String    @map("email_normalized") @db.Citext
  displayName      String    @map("display_name")
  globalStatus     String    @map("global_status")
  emailVerifiedAt  DateTime? @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships    AgencyMembership[]
  identityLinks  ExternalIdentityLink[]
  sessions       UserSession[]
  securityEvents SecurityEvent[]        @relation("SecurityEventUser")
  auditEvents    AuditEvent[]           @relation("AuditEventUser")

  @@unique([identityProvider, externalSubject])
  @@unique([emailNormalized])
  @@map("users")
}

model ExternalIdentityLink {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  issuer       String
  subject      String
  status       String
  linkedAt     DateTime  @default(now()) @map("linked_at") @db.Timestamptz(6)
  supersededAt DateTime? @map("superseded_at") @db.Timestamptz(6)
  reason       String?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([issuer, subject])
  @@index([userId, status])
  @@map("external_identity_links")
}

model AgencyMembership {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId                  String    @map("agency_id") @db.Uuid
  userId                    String    @map("user_id") @db.Uuid
  employeeId                String?   @map("employee_id") @db.Uuid
  primaryOrganizationUnitId String?   @map("primary_organization_unit_id") @db.Uuid
  status                    String
  activatedAt               DateTime? @map("activated_at") @db.Timestamptz(6)
  deactivatedAt             DateTime? @map("deactivated_at") @db.Timestamptz(6)
  deactivationReason        String?   @map("deactivation_reason")
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  agency                                 Agency                         @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  user                                   User                           @relation(fields: [userId], references: [id], onDelete: Restrict)
  primaryOrganizationUnit                OrganizationUnit?              @relation("AgencyMembershipPrimaryUnit", fields: [agencyId, primaryOrganizationUnitId], references: [agencyId, id], onDelete: Restrict)
  membershipRoles                        MembershipRole[]               @relation("MembershipRoleMembership")
  assignedRoleChanges                    MembershipRole[]               @relation("MembershipRoleAssigner")
  invitedUsers                           Invitation[]                   @relation("InvitationInviter")
  rolePermissionGrants                   RolePermission[]               @relation("RolePermissionGrantor")
  delegationsGiven                       DelegatedAuthority[]           @relation("DelegationDelegator")
  delegationsReceived                    DelegatedAuthority[]           @relation("DelegationDelegate")
  sessions                               UserSession[]
  securityEvents                         SecurityEvent[]                @relation("SecurityEventMembership")
  auditEvents                            AuditEvent[]                   @relation("AuditEventMembership")
  createdDocuments                       Document[]                     @relation("DocumentCreator")
  updatedDocuments                       Document[]                     @relation("DocumentUpdater")
  createdDocumentVersions                DocumentVersion[]              @relation("DocumentVersionCreator")
  createdStaffingAuthorities             StaffingAuthority[]            @relation("StaffingAuthorityCreator")
  updatedStaffingAuthorities             StaffingAuthority[]            @relation("StaffingAuthorityUpdater")
  validatedStaffingAuthorities           StaffingAuthority[]            @relation("StaffingAuthorityEvidenceValidator")
  createdQualificationStandards          QualificationStandard[]        @relation("QualificationStandardCreator")
  updatedQualificationStandards          QualificationStandard[]        @relation("QualificationStandardUpdater")
  createdQualificationStandardVersions   QualificationStandardVersion[] @relation("QualificationStandardVersionCreator")
  updatedQualificationStandardVersions   QualificationStandardVersion[] @relation("QualificationStandardVersionUpdater")
  validatedQualificationSourceVersions   QualificationStandardVersion[] @relation("QualificationStandardSourceValidator")
  validatedQualificationApprovalVersions QualificationStandardVersion[] @relation("QualificationStandardApprovalValidator")
  createdPlantillaPositions              PlantillaPosition[]            @relation("PlantillaPositionCreator")
  updatedPlantillaPositions              PlantillaPosition[]            @relation("PlantillaPositionUpdater")
  createdPlantillaPositionVersions       PlantillaPositionVersion[]     @relation("PlantillaPositionVersionCreator")
  updatedPlantillaPositionVersions       PlantillaPositionVersion[]     @relation("PlantillaPositionVersionUpdater")

  @@unique([agencyId, id])
  @@unique([agencyId, id, userId])
  @@index([userId])
  @@map("agency_memberships")
}

model Invitation {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId              String    @map("agency_id") @db.Uuid
  emailNormalized       String    @map("email_normalized") @db.Citext
  invitedByMembershipId String?   @map("invited_by_membership_id") @db.Uuid
  tokenHash             Bytes     @unique @map("token_hash")
  requestedRoleCodes    String[]  @default([]) @map("requested_role_codes")
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt            DateTime? @map("accepted_at") @db.Timestamptz(6)
  cancelledAt           DateTime? @map("cancelled_at") @db.Timestamptz(6)
  status                String
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  agency              Agency            @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  invitedByMembership AgencyMembership? @relation("InvitationInviter", fields: [agencyId, invitedByMembershipId], references: [agencyId, id], onDelete: Restrict)

  @@index([agencyId, emailNormalized, status])
  @@map("invitations")
}

model Role {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId         String?  @map("agency_id") @db.Uuid
  code             String   @db.Citext
  name             String
  isSystemTemplate Boolean  @default(false) @map("is_system_template")
  status           String
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  agency          Agency?          @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  membershipRoles MembershipRole[]
  permissions     RolePermission[]

  @@map("roles")
}

model Permission {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String @unique @db.Citext
  domain      String
  riskLevel   String @map("risk_level")
  description String

  roles                RolePermission[]
  delegatedAuthorities DelegatedAuthority[]

  @@map("permissions")
}

model RolePermission {
  roleId                String   @map("role_id") @db.Uuid
  permissionId          String   @map("permission_id") @db.Uuid
  scopePolicy           String   @map("scope_policy")
  grantedAt             DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)
  grantedByMembershipId String?  @map("granted_by_membership_id") @db.Uuid

  role                Role              @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission          Permission        @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  grantedByMembership AgencyMembership? @relation("RolePermissionGrantor", fields: [grantedByMembershipId], references: [id], onDelete: SetNull)

  @@id([roleId, permissionId, scopePolicy])
  @@map("role_permissions")
}

model MembershipRole {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId               String    @map("agency_id") @db.Uuid
  membershipId           String    @map("membership_id") @db.Uuid
  roleId                 String    @map("role_id") @db.Uuid
  effectiveFrom          DateTime  @map("effective_from") @db.Timestamptz(6)
  effectiveTo            DateTime? @map("effective_to") @db.Timestamptz(6)
  assignedByMembershipId String?   @map("assigned_by_membership_id") @db.Uuid
  reason                 String?
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  agency               Agency            @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  membership           AgencyMembership  @relation("MembershipRoleMembership", fields: [agencyId, membershipId], references: [agencyId, id], onDelete: Restrict)
  role                 Role              @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedByMembership AgencyMembership? @relation("MembershipRoleAssigner", fields: [agencyId, assignedByMembershipId], references: [agencyId, id], onDelete: Restrict)

  @@index([agencyId, membershipId, roleId, effectiveFrom, effectiveTo])
  @@map("membership_roles")
}

model DelegatedAuthority {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId              String   @map("agency_id") @db.Uuid
  delegatorMembershipId String   @map("delegator_membership_id") @db.Uuid
  delegateMembershipId  String   @map("delegate_membership_id") @db.Uuid
  permissionCode        String   @map("permission_code") @db.Citext
  organizationUnitId    String?  @map("organization_unit_id") @db.Uuid
  effectiveFrom         DateTime @map("effective_from") @db.Timestamptz(6)
  effectiveTo           DateTime @map("effective_to") @db.Timestamptz(6)
  status                String
  authorityDocumentId   String?  @map("authority_document_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  agency     Agency           @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  delegator  AgencyMembership @relation("DelegationDelegator", fields: [agencyId, delegatorMembershipId], references: [agencyId, id], onDelete: Restrict)
  delegate   AgencyMembership @relation("DelegationDelegate", fields: [agencyId, delegateMembershipId], references: [agencyId, id], onDelete: Restrict)
  permission Permission       @relation(fields: [permissionCode], references: [code], onDelete: Restrict)

  @@index([agencyId, delegateMembershipId, effectiveFrom, effectiveTo])
  @@map("delegated_authorities")
}

model UserSession {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  agencyId              String    @map("agency_id") @db.Uuid
  agencyMembershipId    String    @map("agency_membership_id") @db.Uuid
  sessionTokenHash      Bytes     @unique @map("session_token_hash")
  providerSid           String?   @map("provider_sid")
  authTime              DateTime? @map("auth_time") @db.Timestamptz(6)
  authenticationMethods String[]  @default([]) @map("authentication_methods")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt            DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt             DateTime? @map("revoked_at") @db.Timestamptz(6)
  revocationReason      String?   @map("revocation_reason")

  user       User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  agency     Agency           @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  membership AgencyMembership @relation(fields: [agencyId, agencyMembershipId, userId], references: [agencyId, id, userId], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([agencyId, agencyMembershipId])
  @@map("user_sessions")
}

model SecurityEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventKey     String?  @unique @map("event_key")
  agencyId     String?  @map("agency_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  membershipId String?  @map("membership_id") @db.Uuid
  eventType    String   @map("event_type")
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  requestId    String?  @map("request_id")
  ipAddress    String?  @map("ip_address") @db.Inet
  userAgent    String?  @map("user_agent")
  details      Json     @default("{}")

  agency     Agency?           @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  user       User?             @relation("SecurityEventUser", fields: [userId], references: [id], onDelete: SetNull)
  membership AgencyMembership? @relation("SecurityEventMembership", fields: [agencyId, membershipId], references: [agencyId, id], onDelete: SetNull)

  @@index([agencyId, occurredAt(sort: Desc)])
  @@map("security_events")
}

model AuditEvent {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId          String   @map("agency_id") @db.Uuid
  actorUserId       String?  @map("actor_user_id") @db.Uuid
  actorMembershipId String?  @map("actor_membership_id") @db.Uuid
  actorType         String   @map("actor_type")
  action            String
  entityType        String   @map("entity_type")
  entityId          String   @map("entity_id") @db.Uuid
  previousStatus    String?  @map("previous_status")
  newStatus         String?  @map("new_status")
  reason            String?
  requestId         String?  @map("request_id")
  idempotencyKey    String?  @map("idempotency_key")
  occurredAt        DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  metadata          Json     @default("{}")

  agency          Agency            @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  actorUser       User?             @relation("AuditEventUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorMembership AgencyMembership? @relation("AuditEventMembership", fields: [agencyId, actorMembershipId], references: [agencyId, id], onDelete: SetNull)

  @@unique([agencyId, action, entityId, idempotencyKey])
  @@index([agencyId, occurredAt(sort: Desc)])
  @@map("audit_events")
}

model Document {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId              String   @map("agency_id") @db.Uuid
  documentNo            String?  @map("document_no") @db.Citext
  documentType          String   @map("document_type")
  classification        String
  status                String
  currentVersionId      String?  @map("current_version_id") @db.Uuid
  createdByMembershipId String   @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedByMembershipId String?  @map("updated_by_membership_id") @db.Uuid
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion            Int      @default(1) @map("row_version")

  agency                                Agency                         @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  createdBy                             AgencyMembership               @relation("DocumentCreator", fields: [agencyId, createdByMembershipId], references: [agencyId, id], onDelete: Restrict)
  updatedBy                             AgencyMembership?              @relation("DocumentUpdater", fields: [agencyId, updatedByMembershipId], references: [agencyId, id], onDelete: Restrict)
  currentVersion                        DocumentVersion?               @relation("DocumentCurrentVersion", fields: [agencyId, currentVersionId], references: [agencyId, id], onDelete: Restrict)
  versions                              DocumentVersion[]              @relation("DocumentVersions")
  staffingAuthorities                   StaffingAuthority[]            @relation("StaffingAuthorityEvidenceDocument")
  staffingAuthorityRevocations          StaffingAuthority[]            @relation("StaffingAuthorityRevocationDocument")
  qualificationStandardSourceVersions   QualificationStandardVersion[] @relation("QualificationStandardSourceDocument")
  qualificationStandardApprovalVersions QualificationStandardVersion[] @relation("QualificationStandardApprovalDocument")

  @@unique([agencyId, id])
  @@unique([agencyId, documentNo])
  @@map("documents")
}

model DocumentVersion {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId              String    @map("agency_id") @db.Uuid
  documentId            String    @map("document_id") @db.Uuid
  versionNo             Int       @map("version_no")
  storageKey            String    @unique @map("storage_key")
  contentHash           String    @map("content_hash")
  mimeType              String    @map("mime_type")
  sizeBytes             BigInt    @map("size_bytes")
  createdByMembershipId String    @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  issuedAt              DateTime? @map("issued_at") @db.Timestamptz(6)
  signatureMetadata     Json?     @map("signature_metadata")

  agency                                        Agency                         @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  document                                      Document                       @relation("DocumentVersions", fields: [agencyId, documentId], references: [agencyId, id], onDelete: Restrict)
  currentForDocuments                           Document[]                     @relation("DocumentCurrentVersion")
  createdBy                                     AgencyMembership               @relation("DocumentVersionCreator", fields: [agencyId, createdByMembershipId], references: [agencyId, id], onDelete: Restrict)
  staffingAuthorityEvidenceVersions             StaffingAuthority[]            @relation("StaffingAuthorityEvidenceVersion")
  staffingAuthorityRevocationVersions           StaffingAuthority[]            @relation("StaffingAuthorityRevocationVersion")
  qualificationStandardSourceEvidenceVersions   QualificationStandardVersion[] @relation("QualificationStandardSourceVersion")
  qualificationStandardApprovalEvidenceVersions QualificationStandardVersion[] @relation("QualificationStandardApprovalVersion")

  @@unique([documentId, versionNo])
  @@unique([agencyId, id])
  @@unique([agencyId, documentId, id])
  @@index([agencyId, documentId, versionNo])
  @@map("document_versions")
}

model StaffingAuthority {
  id                              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId                        String    @map("agency_id") @db.Uuid
  authorityType                   String    @map("authority_type")
  referenceNo                     String    @map("reference_no") @db.Citext
  issuedDate                      DateTime  @map("issued_date") @db.Date
  effectiveDate                   DateTime  @map("effective_date") @db.Date
  sourceMetadata                  Json      @default("{}") @map("source_metadata")
  documentId                      String?   @map("document_id") @db.Uuid
  evidenceVersionId               String?   @map("evidence_version_id") @db.Uuid
  evidenceValidatedAt             DateTime? @map("evidence_validated_at") @db.Timestamptz(6)
  evidenceValidatedByMembershipId String?   @map("evidence_validated_by_membership_id") @db.Uuid
  evidenceValidationReason        String?   @map("evidence_validation_reason")
  status                          String
  supersededEffectiveDate         DateTime? @map("superseded_effective_date") @db.Date
  revokedEffectiveDate            DateTime? @map("revoked_effective_date") @db.Date
  revocationReason                String?   @map("revocation_reason")
  revocationDocumentId            String?   @map("revocation_document_id") @db.Uuid
  revocationEvidenceVersionId     String?   @map("revocation_evidence_version_id") @db.Uuid
  createdByMembershipId           String    @map("created_by_membership_id") @db.Uuid
  createdAt                       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedByMembershipId           String    @map("updated_by_membership_id") @db.Uuid
  updatedAt                       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion                      Int       @default(1) @map("row_version")

  agency                    Agency                     @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  evidenceDocument          Document?                  @relation("StaffingAuthorityEvidenceDocument", fields: [agencyId, documentId], references: [agencyId, id], onDelete: Restrict)
  evidenceVersion           DocumentVersion?           @relation("StaffingAuthorityEvidenceVersion", fields: [agencyId, documentId, evidenceVersionId], references: [agencyId, documentId, id], onDelete: Restrict)
  revocationDocument        Document?                  @relation("StaffingAuthorityRevocationDocument", fields: [agencyId, revocationDocumentId], references: [agencyId, id], onDelete: Restrict)
  revocationEvidenceVersion DocumentVersion?           @relation("StaffingAuthorityRevocationVersion", fields: [agencyId, revocationDocumentId, revocationEvidenceVersionId], references: [agencyId, documentId, id], onDelete: Restrict)
  evidenceValidatedBy       AgencyMembership?          @relation("StaffingAuthorityEvidenceValidator", fields: [agencyId, evidenceValidatedByMembershipId], references: [agencyId, id], onDelete: Restrict)
  createdBy                 AgencyMembership           @relation("StaffingAuthorityCreator", fields: [agencyId, createdByMembershipId], references: [agencyId, id], onDelete: Restrict)
  updatedBy                 AgencyMembership           @relation("StaffingAuthorityUpdater", fields: [agencyId, updatedByMembershipId], references: [agencyId, id], onDelete: Restrict)
  createdPositions          PlantillaPosition[]        @relation("PlantillaPositionCreatedFromAuthority")
  positionVersions          PlantillaPositionVersion[] @relation("PlantillaPositionVersionStaffingAuthority")

  @@unique([agencyId, id])
  @@unique([agencyId, referenceNo])
  @@index([agencyId, status, effectiveDate])
  @@map("staffing_authorities")
}

model QualificationStandard {
