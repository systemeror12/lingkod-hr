  appointmentVersionId String @map("appointment_version_id") @db.Uuid
  documentVersionId    String @map("document_version_id") @db.Uuid
  linkRole             String @map("link_role")

  agency             Agency             @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  appointmentVersion AppointmentVersion @relation(fields: [agencyId, appointmentVersionId], references: [agencyId, id], onDelete: Restrict)
  documentVersion    DocumentVersion    @relation("AppointmentEvidenceVersion", fields: [agencyId, documentVersionId], references: [agencyId, id], onDelete: Restrict)

  @@unique([appointmentVersionId, documentVersionId, linkRole])
  @@unique([agencyId, id])
  @@map("appointment_document_version_links")
}
