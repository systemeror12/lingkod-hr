  approvalRouteVersions         ApprovalRouteVersion[]
  approvalRequests              ApprovalRequest[]
  approvalSteps                 ApprovalStep[]
  approvalDecisions             ApprovalDecision[]
  meritSelectionPlans           AgencyMeritSelectionPlanVersion[]
  meritSelectionCriteriaSets    MeritSelectionCriteriaSet[]
  boardDefinitions              BoardDefinition[]
  boardAppointments             BoardAppointment[]
  requestsToFill                RequestToFill[]
  requestApprovalRouteBindings  RequestApprovalRouteBinding[]
  requestMspRebaselines         RequestMspRebaseline[]
  vacancyPublications           VacancyPublication[]
  vacancyPublicationEvidence    VacancyPublicationEvidence[]
  applicants                    Applicant[]
  applications                  Application[]
  applicationDocuments          ApplicationDocument[]
  applicationScreenings         ApplicationScreening[]
  applicationScreeningEvidence  ApplicationScreeningEvidence[]
  assessments                   Assessment[]
  assessmentResultVersions      AssessmentResultVersion[]
  interviews                    Interview[]
  interviewFeedbackVersions     InterviewFeedbackVersion[]
  selectionBoardSessions        SelectionBoardSession[]
  boardRosterSnapshotMembers    BoardRosterSnapshotMember[]
  boardMemberParticipations     BoardMemberParticipation[]
  conflictDeclarations          ConflictDeclaration[]
  applicantQuorumSnapshots      ApplicantQuorumSnapshot[]
  boardRecommendations          BoardRecommendation[]
  candidateEvaluationReports    CandidateEvaluationReportVersion[]
  selectionDecisions            SelectionDecision[]
  appointmentHandoffs           RecruitmentAppointmentHandoff[]
  leaveTypes                    LeaveType[]
  leavePolicyVersions           LeavePolicyVersion[]
  leavePolicyAuthorities        LeavePolicyAuthority[]
  leaveAccounts                 LeaveAccount[]
  leaveLedgerEntries            LeaveLedgerEntry[]
  leaveCreditCommitments        LeaveCreditCommitment[]
  leaveAccountOpenings          LeaveAccountOpening[]
  leaveLedgerAdjustments        LeaveLedgerAdjustment[]
  leaveApplications             LeaveApplication[]
  leaveApplicationDraftPeriods  LeaveApplicationDraftPeriod[]
  leaveApplicationDraftDocuments LeaveApplicationDraftDocument[]
  leaveApplicationVersions      LeaveApplicationVersion[]
  leaveApplicationPeriods       LeaveApplicationPeriod[]
  leaveApplicationVersionDocuments LeaveApplicationVersionDocument[]
  leaveEligibilityAssessments   LeaveEligibilityAssessment[]
  leaveCalculationSegments      LeaveCalculationSegment[]
  leaveCreditCertifications     LeaveCreditCertification[]
  leaveCreditCertificationLines LeaveCreditCertificationLine[]
  leaveRecommendations          LeaveRecommendation[]
  leaveApprovalAllocations      LeaveApprovalAllocation[]
  leaveApprovalAllocationLines  LeaveApprovalAllocationLine[]
  leaveCancellationEffects      LeaveCancellationEffect[]
  leaveCancellations            LeaveCancellation[]
  leaveCancellationDocuments    LeaveCancellationDocument[]
  leaveCancellationScopes       LeaveCancellationScope[]
  leaveMonetizationRequests     LeaveMonetizationRequest[]
  leaveMonetizationVersions     LeaveMonetizationRequestVersion[]
  monetizationAllocations       LeaveMonetizationAllocation[]
  monetizationAssessments       MonetizationEligibilityAssessment[]
  monetizationCertifications    MonetizationCreditCertification[]
  monetizationCertificationLines MonetizationCreditCertificationLine[]
  monetizationFundingDeterminations MonetizationFundingDetermination[]
  monetizationPostings          MonetizationPosting[]
  monetizationAdjustments       MonetizationAdjustment[]
  monetizationAdjustmentLines   MonetizationAdjustmentLine[]
  payrollMonetizationInputs     PayrollMonetizationEarningInput[]
  payrollMonetizationOutcomes   PayrollMonetizationAdjustmentOutcome[]
  terminalLeaveInputAssessments TerminalLeaveInputAssessment[]
  terminalLeaveInputSnapshots   TerminalLeaveInputSnapshot[]
  terminalLeaveInputLines       TerminalLeaveInputSnapshotLine[]
  terminalLeaveInputOutcomes    TerminalLeaveInputHandoffOutcome[]
  attendancePeriods             AttendancePeriod[]
  attendanceDays                AttendanceDay[]
  attendanceDaySegments         AttendanceDaySegment[]
  attendanceExceptions          AttendanceException[]
  employeeAttendanceSubmissions EmployeeAttendanceSubmission[]
  employeeAttendanceSubmissionDays EmployeeAttendanceSubmissionDay[]
  attendancePeriodVersions      AttendancePeriodVersion[]
  attendancePeriodVersionDays   AttendancePeriodVersionDay[]
