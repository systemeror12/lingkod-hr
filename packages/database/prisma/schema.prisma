  ledgerRecordedThrough     DateTime @map("ledger_recorded_through") @db.Timestamptz(6)
  certifiedByMembershipId   String   @map("certified_by_membership_id") @db.Uuid
  certifiedAt               DateTime @default(now()) @map("certified_at") @db.Timestamptz(6)

  agency                Agency                    @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  leaveApplicationVersion LeaveApplicationVersion @relation("LeaveCreditCertificationVersion", fields: [agencyId, leaveApplicationVersionId], references: [agencyId, id], onDelete: Restrict)
  eligibilityAssessment LeaveEligibilityAssessment @relation("LeaveCreditCertificationAssessment", fields: [agencyId, leaveApplicationVersionId, eligibilityAssessmentId], references: [agencyId, leaveApplicationVersionId, id], onDelete: Restrict, map: "leave_credit_certifications_assessment_fkey")
  approvalDecision      ApprovalDecision          @relation("LeaveCreditCertificationDecision", fields: [agencyId, approvalDecisionId], references: [agencyId, id], onDelete: Restrict)
  certifiedBy           AgencyMembership          @relation("LeaveCreditCertificationCertifier", fields: [agencyId, certifiedByMembershipId], references: [agencyId, id], onDelete: Restrict)
  lines                 LeaveCreditCertificationLine[]

  @@unique([leaveApplicationVersionId])
  @@unique([agencyId, leaveApplicationVersionId])
  @@unique([agencyId, id])
  @@map("leave_credit_certifications")
}

