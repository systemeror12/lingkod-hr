generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

model Agency {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                    String   @unique @db.Citext
  name                    String
  acronym                 String?
  agencyType              String   @map("agency_type")
  status                  String
  defaultTimezone         String   @default("Asia/Manila") @map("default_timezone")
  defaultCurrency         String   @default("PHP") @map("default_currency") @db.Char(3)
  currentProfileVersionId String?  @map("current_profile_version_id") @db.Uuid
  rowVersion              Int      @default(1) @map("row_version")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  currentProfile                AgencyProfileVersion?              @relation("AgencyCurrentProfile", fields: [id, currentProfileVersionId], references: [agencyId, id], onDelete: Restrict, map: "agencies_current_profile_fkey")
  profiles                      AgencyProfileVersion[]             @relation("AgencyProfiles")
  memberships                   AgencyMembership[]
  invitations                   Invitation[]
  roles                         Role[]
  membershipRoles               MembershipRole[]
  delegatedAuthorities          DelegatedAuthority[]
  sessions                      UserSession[]
  securityEvents                SecurityEvent[]
  auditEvents                   AuditEvent[]
  governmentIdentifiers         GovernmentIdentifier[]
  payrollBankAccounts           PayrollBankAccount[]
  salnComplianceRecords         SalnComplianceRecord[]
  organizationUnits             OrganizationUnit[]
  organizationUnitVersions      OrganizationUnitVersion[]
  documents                     Document[]
  documentVersions              DocumentVersion[]
  staffingAuthorities           StaffingAuthority[]
  qualificationStandards        QualificationStandard[]
  qualificationStandardVersions QualificationStandardVersion[]
  plantillaPositions            PlantillaPosition[]
  appointmentAgencySetting      AppointmentAgencySettings?
  appointments                  Appointment[]
  appointmentVersions           AppointmentVersion[]
  appointmentEvidenceLinks      AppointmentDocumentVersionLink[]
  plantillaPositionVersions     PlantillaPositionVersion[]
  positionDocuments             PositionDocument[]
  employees                     Employee[]
  employeeDocuments             EmployeeDocument[]
  pdsVersions                   PdsVersion[]
  pdsPersonalDetails            PdsPersonalDetails[]
  pdsFamilyRecords              PdsFamilyRecord[]
  pdsEducationRecords           PdsEducationRecord[]
  pdsEligibilityRecords         PdsEligibilityRecord[]
  pdsWorkExperienceRecords      PdsWorkExperienceRecord[]
  pdsVoluntaryWorkRecords       PdsVoluntaryWorkRecord[]
  pdsLearningDevelopmentRecords PdsLearningDevelopmentRecord[]
  pdsWesArtifacts               PdsWesArtifact[]
  pdsWesEntries                 PdsWesEntry[]
  pdsOtherInformation           PdsOtherInformation[]
  pdsDeclarationDetails         PdsDeclarationDetails[]
  pdsReferenceRecords           PdsReferenceRecord[]
  pdsCertificationDetails       PdsCertificationDetails[]
  pdsPageSignatures             PdsPageSignature[]
  pdsTransitionEvents           PdsTransitionEvent[]
  pdsOutputArtifacts            PdsOutputArtifact[]
  personnelBaselines            PersonnelBaseline[]
  personnelActions              PersonnelAction[]
  personnelActionVersions       PersonnelActionVersion[]
  personnelActionEvidence       PersonnelActionEvidence[]
  serviceSegments               ServiceSegment[]
  positionIncumbencies          PositionIncumbency[]
  separationCases               SeparationCase[]
  separationEffects             SeparationEffect[]
  serviceRecordSnapshots        ServiceRecordSnapshot[]
  outboxEvents                  OutboxEvent[]
  approvalRouteVersions         ApprovalRouteVersion[]
  approvalRequests              ApprovalRequest[]
  approvalSteps                 ApprovalStep[]
  approvalDecisions             ApprovalDecision[]
  meritSelectionPlans           AgencyMeritSelectionPlanVersion[]
  meritSelectionCriteriaSets    MeritSelectionCriteriaSet[]
  boardDefinitions              BoardDefinition[]
  boardAppointments             BoardAppointment[]
  requestsToFill                RequestToFill[]
  requestApprovalRouteBindings  RequestApprovalRouteBinding[]
  requestMspRebaselines         RequestMspRebaseline[]
  vacancyPublications           VacancyPublication[]
  vacancyPublicationEvidence    VacancyPublicationEvidence[]
  applicants                    Applicant[]
  applications                  Application[]
  applicationDocuments          ApplicationDocument[]
  applicationScreenings         ApplicationScreening[]
  applicationScreeningEvidence  ApplicationScreeningEvidence[]
  assessments                   Assessment[]
  assessmentResultVersions      AssessmentResultVersion[]
  interviews                    Interview[]
  interviewFeedbackVersions     InterviewFeedbackVersion[]
  selectionBoardSessions        SelectionBoardSession[]
  boardRosterSnapshotMembers    BoardRosterSnapshotMember[]
  boardMemberParticipations     BoardMemberParticipation[]
  conflictDeclarations          ConflictDeclaration[]
  applicantQuorumSnapshots      ApplicantQuorumSnapshot[]
  boardRecommendations          BoardRecommendation[]
  candidateEvaluationReports    CandidateEvaluationReportVersion[]
  selectionDecisions            SelectionDecision[]
  appointmentHandoffs           RecruitmentAppointmentHandoff[]

  @@unique([id, code])
  @@map("agencies")
}

model AgencyProfileVersion {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId                 String    @map("agency_id") @db.Uuid
  versionNo                Int       @map("version_no")
  officialName             String    @map("official_name")
  acronym                  String?
  agencyType               String    @default("NGA") @map("agency_type")
  parentOrganization       String?   @map("parent_organization")
  reportingIdentifiers     String?   @map("reporting_identifiers")
  appointingAuthorityTitle String?   @map("appointing_authority_title")
  defaultTimezone          String    @default("Asia/Manila") @map("default_timezone")
  defaultCurrency          String    @default("PHP") @map("default_currency") @db.Char(3)
  deploymentProfile        String    @map("deployment_profile")
  effectiveFrom            DateTime  @map("effective_from") @db.Date
  effectiveTo              DateTime? @map("effective_to") @db.Date
  configuration            Json      @default("{}")
  status                   String
  domainStatus             String    @default("ACTIVE") @map("domain_status")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  agency             Agency   @relation("AgencyProfiles", fields: [agencyId], references: [id], onDelete: Restrict)
  currentForAgencies Agency[] @relation("AgencyCurrentProfile")

  @@unique([agencyId, versionNo])
  @@unique([agencyId, id])
  @@index([agencyId, effectiveFrom])
  @@map("agency_profile_versions")
}

model OrganizationUnit {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId         String   @map("agency_id") @db.Uuid
  code             String   @db.Citext
  unitType         String   @map("unit_type")
  status           String
  currentVersionId String?  @map("current_version_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  agency                    Agency                     @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  currentVersion            OrganizationUnitVersion?   @relation("OrganizationUnitCurrentVersion", fields: [agencyId, currentVersionId], references: [agencyId, id], onDelete: Restrict)
  versions                  OrganizationUnitVersion[]  @relation("OrganizationUnitVersions")
  childVersions             OrganizationUnitVersion[]  @relation("OrganizationUnitVersionParent")
  primaryMemberships        AgencyMembership[]         @relation("AgencyMembershipPrimaryUnit")
  plantillaPositionVersions PlantillaPositionVersion[] @relation("PlantillaPositionOrganizationUnit")
  serviceSegments           ServiceSegment[]           @relation("ServiceSegmentOrganizationUnit")
  personnelBaselines        PersonnelBaseline[]        @relation("PersonnelBaselineOrganizationUnit")
  personnelActionTargets    PersonnelActionVersion[]   @relation("PersonnelActionTargetOrganizationUnit")
  requestsToFill            RequestToFill[]            @relation("RequestToFillRequestingUnit")

  @@unique([agencyId, id])
  @@unique([agencyId, code])
  @@map("organization_units")
}

model OrganizationUnitVersion {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId                 String    @map("agency_id") @db.Uuid
  organizationUnitId       String    @map("organization_unit_id") @db.Uuid
  versionNo                Int       @map("version_no")
  name                     String
  parentUnitId             String?   @map("parent_unit_id") @db.Uuid
  headPositionId           String?   @map("head_position_id") @db.Uuid
  costCenterCode           String?   @map("cost_center_code")
  responsibilityCenterCode String?   @map("responsibility_center_code")
  effectiveFrom            DateTime  @map("effective_from") @db.Date
  effectiveTo              DateTime? @map("effective_to") @db.Date
  status                   String
  domainStatus             String    @default("ACTIVE") @map("domain_status")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  agency           Agency             @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  organizationUnit OrganizationUnit   @relation("OrganizationUnitVersions", fields: [agencyId, organizationUnitId], references: [agencyId, id], onDelete: Restrict)
  currentForUnits  OrganizationUnit[] @relation("OrganizationUnitCurrentVersion")
  parentUnit       OrganizationUnit?  @relation("OrganizationUnitVersionParent", fields: [agencyId, parentUnitId], references: [agencyId, id], onDelete: Restrict)
  headPosition     PlantillaPosition? @relation("OrganizationUnitHead", fields: [agencyId, headPositionId], references: [agencyId, id], onDelete: Restrict)

  @@unique([organizationUnitId, versionNo])
  @@unique([agencyId, id])
  @@index([agencyId, parentUnitId, effectiveFrom])
  @@map("organization_unit_versions")
}

model User {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identityProvider String    @map("identity_provider")
  externalSubject  String    @map("external_subject")
  emailNormalized  String    @map("email_normalized") @db.Citext
  displayName      String    @map("display_name")
  globalStatus     String    @map("global_status")
  emailVerifiedAt  DateTime? @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships    AgencyMembership[]
  identityLinks  ExternalIdentityLink[]
  sessions       UserSession[]
  securityEvents SecurityEvent[]        @relation("SecurityEventUser")
  auditEvents    AuditEvent[]           @relation("AuditEventUser")

  @@unique([identityProvider, externalSubject])
  @@unique([emailNormalized])
  @@map("users")
}

model ExternalIdentityLink {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  issuer       String
  subject      String
  status       String
  linkedAt     DateTime  @default(now()) @map("linked_at") @db.Timestamptz(6)
  supersededAt DateTime? @map("superseded_at") @db.Timestamptz(6)
  reason       String?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([issuer, subject])
  @@index([userId, status])
  @@map("external_identity_links")
}

model AgencyMembership {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId                  String    @map("agency_id") @db.Uuid
  userId                    String    @map("user_id") @db.Uuid
  employeeId                String?   @map("employee_id") @db.Uuid
  primaryOrganizationUnitId String?   @map("primary_organization_unit_id") @db.Uuid
  status                    String
  activatedAt               DateTime? @map("activated_at") @db.Timestamptz(6)
  deactivatedAt             DateTime? @map("deactivated_at") @db.Timestamptz(6)
  deactivationReason        String?   @map("deactivation_reason")
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  agency                                 Agency                             @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  user                                   User                               @relation(fields: [userId], references: [id], onDelete: Restrict)
  primaryOrganizationUnit                OrganizationUnit?                  @relation("AgencyMembershipPrimaryUnit", fields: [agencyId, primaryOrganizationUnitId], references: [agencyId, id], onDelete: Restrict)
  membershipRoles                        MembershipRole[]                   @relation("MembershipRoleMembership")
  assignedRoleChanges                    MembershipRole[]                   @relation("MembershipRoleAssigner")
  invitedUsers                           Invitation[]                       @relation("InvitationInviter")
  rolePermissionGrants                   RolePermission[]                   @relation("RolePermissionGrantor")
  delegationsGiven                       DelegatedAuthority[]               @relation("DelegationDelegator")
  delegationsReceived                    DelegatedAuthority[]               @relation("DelegationDelegate")
  preparedPersonnelActions               PersonnelAction[]                  @relation("PersonnelActionPreparer")
  approvedPersonnelActions               PersonnelAction[]                  @relation("PersonnelActionApprover")
  effectuatedPersonnelActions            PersonnelAction[]                  @relation("PersonnelActionEffectuator")
  initiatedSeparationCases               SeparationCase[]                   @relation("SeparationCaseInitiator")
  approvedSeparationCases                SeparationCase[]                   @relation("SeparationCaseApprover")
  createdPersonnelActionVersions         PersonnelActionVersion[]           @relation("PersonnelActionVersionCreator")
  createdPersonnelActionEvidence         PersonnelActionEvidence[]          @relation("PersonnelActionEvidenceCreator")
  sessions                               UserSession[]
  securityEvents                         SecurityEvent[]                    @relation("SecurityEventMembership")
  auditEvents                            AuditEvent[]                       @relation("AuditEventMembership")
  createdDocuments                       Document[]                         @relation("DocumentCreator")
  updatedDocuments                       Document[]                         @relation("DocumentUpdater")
  createdDocumentVersions                DocumentVersion[]                  @relation("DocumentVersionCreator")
  createdStaffingAuthorities             StaffingAuthority[]                @relation("StaffingAuthorityCreator")
  updatedStaffingAuthorities             StaffingAuthority[]                @relation("StaffingAuthorityUpdater")
  validatedStaffingAuthorities           StaffingAuthority[]                @relation("StaffingAuthorityEvidenceValidator")
  createdQualificationStandards          QualificationStandard[]            @relation("QualificationStandardCreator")
  updatedQualificationStandards          QualificationStandard[]            @relation("QualificationStandardUpdater")
  createdQualificationStandardVersions   QualificationStandardVersion[]     @relation("QualificationStandardVersionCreator")
  updatedQualificationStandardVersions   QualificationStandardVersion[]     @relation("QualificationStandardVersionUpdater")
  validatedQualificationSourceVersions   QualificationStandardVersion[]     @relation("QualificationStandardSourceValidator")
  validatedQualificationApprovalVersions QualificationStandardVersion[]     @relation("QualificationStandardApprovalValidator")
  createdPlantillaPositions              PlantillaPosition[]                @relation("PlantillaPositionCreator")
  updatedPlantillaPositions              PlantillaPosition[]                @relation("PlantillaPositionUpdater")
  createdPlantillaPositionVersions       PlantillaPositionVersion[]         @relation("PlantillaPositionVersionCreator")
  updatedPlantillaPositionVersions       PlantillaPositionVersion[]         @relation("PlantillaPositionVersionUpdater")
  employee                               Employee?                          @relation("AgencyMembershipEmployee", fields: [agencyId, employeeId], references: [agencyId, id], onDelete: Restrict)
  createdEmployees                       Employee[]                         @relation("EmployeeCreator")
  updatedEmployees                       Employee[]                         @relation("EmployeeUpdater")
  createdEmployeeDocuments               EmployeeDocument[]                 @relation("EmployeeDocumentCreator")
  createdPdsVersions                     PdsVersion[]                       @relation("PdsVersionCreator")
  updatedPdsVersions                     PdsVersion[]                       @relation("PdsVersionUpdater")
  pdsTransitionEvents                    PdsTransitionEvent[]               @relation("PdsTransitionActor")
  createdPersonnelBaselines              PersonnelBaseline[]                @relation("PersonnelBaselineCreator")
  updatedPersonnelBaselines              PersonnelBaseline[]                @relation("PersonnelBaselineUpdater")
  reviewedPersonnelBaselines             PersonnelBaseline[]                @relation("PersonnelBaselineReviewer")
  effectuatedPersonnelBaselines          PersonnelBaseline[]                @relation("PersonnelBaselineEffectuator")
  createdServiceSegments                 ServiceSegment[]                   @relation("ServiceSegmentCreator")
  createdPositionIncumbencies            PositionIncumbency[]               @relation("PositionIncumbencyCreator")
  createdGovernmentIdentifiers           GovernmentIdentifier[]             @relation("GovernmentIdentifierCreator")
  updatedGovernmentIdentifiers           GovernmentIdentifier[]             @relation("GovernmentIdentifierUpdater")
  createdPayrollBankAccounts             PayrollBankAccount[]               @relation("PayrollBankAccountCreator")
  createdSalnComplianceRecords           SalnComplianceRecord[]             @relation("SalnComplianceCreator")
  updatedPayrollBankAccounts             PayrollBankAccount[]               @relation("PayrollBankAccountUpdater")
  generatedServiceRecords                ServiceRecordSnapshot[]            @relation("ServiceRecordGenerator")
  requestedApprovalRequests              ApprovalRequest[]                  @relation("ApprovalRequestRequester")
  assignedApprovalSteps                  ApprovalStep[]                     @relation("ApprovalStepAssignee")
  approvalDecisions                      ApprovalDecision[]                 @relation("ApprovalDecisionDecider")
  createdMeritSelectionPlans             AgencyMeritSelectionPlanVersion[]  @relation("MeritSelectionPlanCreator")
  updatedMeritSelectionPlans             AgencyMeritSelectionPlanVersion[]  @relation("MeritSelectionPlanUpdater")
  createdMeritSelectionCriteriaSets      MeritSelectionCriteriaSet[]        @relation("MeritSelectionCriteriaSetCreator")
  updatedMeritSelectionCriteriaSets      MeritSelectionCriteriaSet[]        @relation("MeritSelectionCriteriaSetUpdater")
  createdBoardDefinitions                BoardDefinition[]                  @relation("BoardDefinitionCreator")
  updatedBoardDefinitions                BoardDefinition[]                  @relation("BoardDefinitionUpdater")
  createdBoardAppointments               BoardAppointment[]                 @relation("BoardAppointmentCreator")
  boardAppointments                      BoardAppointment[]                 @relation("BoardAppointmentMember")
  requestApprovalRouteBindings           RequestApprovalRouteBinding[]      @relation("RequestApprovalRouteBindingMember")
  createdRequestsToFill                  RequestToFill[]                    @relation("RequestToFillCreator")
  updatedRequestsToFill                  RequestToFill[]                    @relation("RequestToFillUpdater")
  requestedRequestsToFill                RequestToFill[]                    @relation("RequestToFillRequester")
  authorizedRequestMspRebaselines        RequestMspRebaseline[]             @relation("RequestMspRebaselineAuthorizer")
  createdVacancyPublications             VacancyPublication[]               @relation("VacancyPublicationCreator")
  updatedVacancyPublications             VacancyPublication[]               @relation("VacancyPublicationUpdater")
  certifiedVacancyPublications           VacancyPublication[]               @relation("VacancyPublicationCertifier")
  createdVacancyPublicationEvidence      VacancyPublicationEvidence[]       @relation("VacancyPublicationEvidenceCreator")
  createdApplicants                      Applicant[]                        @relation("ApplicantCreator")
  receivedApplications                   Application[]                      @relation("ApplicationReceiver")
  createdApplications                    Application[]                      @relation("ApplicationCreator")
  updatedApplications                    Application[]                      @relation("ApplicationUpdater")
  linkedApplicationDocuments             ApplicationDocument[]              @relation("ApplicationDocumentLinker")
  screenedApplications                   ApplicationScreening[]             @relation("ApplicationScreeningScreener")
  createdAssessments                     Assessment[]                       @relation("AssessmentCreator")
  updatedAssessments                     Assessment[]                       @relation("AssessmentUpdater")
  evaluatedAssessmentResults             AssessmentResultVersion[]          @relation("AssessmentResultEvaluator")
  createdInterviews                      Interview[]                        @relation("InterviewCreator")
  updatedInterviews                      Interview[]                        @relation("InterviewUpdater")
  submittedInterviewFeedback             InterviewFeedbackVersion[]         @relation("InterviewFeedbackInterviewer")
  createdSelectionBoardSessions          SelectionBoardSession[]            @relation("SelectionBoardSessionCreator")
  updatedSelectionBoardSessions          SelectionBoardSession[]            @relation("SelectionBoardSessionUpdater")
  boardRosterSnapshotMemberships         BoardRosterSnapshotMember[]        @relation("BoardRosterSnapshotMemberMembership")
  boardMemberParticipations              BoardMemberParticipation[]         @relation("BoardMemberParticipationMembership")
  recordedBoardMemberParticipations      BoardMemberParticipation[]         @relation("BoardMemberParticipationRecorder")
  declaredConflicts                      ConflictDeclaration[]              @relation("ConflictDeclarationDeclarer")
  frozenApplicantQuorumSnapshots         ApplicantQuorumSnapshot[]          @relation("ApplicantQuorumSnapshotFrozer")
  recordedBoardRecommendations           BoardRecommendation[]              @relation("BoardRecommendationRecorder")
  issuedCandidateEvaluationReports       CandidateEvaluationReportVersion[] @relation("CandidateEvaluationReportIssuer")
  selectionDecisions                     SelectionDecision[]                @relation("SelectionDecisionDecider")
  configuredAppointmentSettings          AppointmentAgencySettings[]        @relation("AppointmentSettingConfigurator")
  updatedAppointmentSettings             AppointmentAgencySettings[]        @relation("AppointmentSettingUpdater")
  createdAppointments                    Appointment[]                      @relation("AppointmentCreator")
  updatedAppointments                    Appointment[]                      @relation("AppointmentUpdater")
  appointingAuthorityAppointmentVersions AppointmentVersion[]               @relation("AppointmentVersionAuthority")
  issuedAppointmentVersions              AppointmentVersion[]               @relation("AppointmentVersionIssuer")
  createdAppointmentVersions             AppointmentVersion[]               @relation("AppointmentVersionCreator")
  updatedAppointmentVersions             AppointmentVersion[]               @relation("AppointmentVersionUpdater")

  @@unique([agencyId, id])
  @@unique([agencyId, id, userId])
  @@index([userId])
  @@map("agency_memberships")
}

model Invitation {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId              String    @map("agency_id") @db.Uuid
  emailNormalized       String    @map("email_normalized") @db.Citext
  invitedByMembershipId String?   @map("invited_by_membership_id") @db.Uuid
  tokenHash             Bytes     @unique @map("token_hash")
  requestedRoleCodes    String[]  @default([]) @map("requested_role_codes")
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt            DateTime? @map("accepted_at") @db.Timestamptz(6)
  cancelledAt           DateTime? @map("cancelled_at") @db.Timestamptz(6)
  status                String
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  agency              Agency            @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  invitedByMembership AgencyMembership? @relation("InvitationInviter", fields: [agencyId, invitedByMembershipId], references: [agencyId, id], onDelete: Restrict)

  @@index([agencyId, emailNormalized, status])
  @@map("invitations")
}

model Role {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId         String?  @map("agency_id") @db.Uuid
  code             String   @db.Citext
  name             String
  isSystemTemplate Boolean  @default(false) @map("is_system_template")
  status           String
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  agency          Agency?          @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  membershipRoles MembershipRole[]
  permissions     RolePermission[]

  @@map("roles")
}

model Permission {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String @unique @db.Citext
  domain      String
  riskLevel   String @map("risk_level")
  description String

  roles                RolePermission[]
  delegatedAuthorities DelegatedAuthority[]
  approvalSteps        ApprovalStep[]
  approvalApproveSteps ApprovalStep[]       @relation("ApprovalStepApprovePermission")
  approvalReturnSteps  ApprovalStep[]       @relation("ApprovalStepReturnPermission")
  approvalRejectSteps  ApprovalStep[]       @relation("ApprovalStepRejectPermission")

  @@map("permissions")
}

model RolePermission {
  roleId                String   @map("role_id") @db.Uuid
  permissionId          String   @map("permission_id") @db.Uuid
  scopePolicy           String   @map("scope_policy")
  grantedAt             DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)
  grantedByMembershipId String?  @map("granted_by_membership_id") @db.Uuid

  role                Role              @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission          Permission        @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  grantedByMembership AgencyMembership? @relation("RolePermissionGrantor", fields: [grantedByMembershipId], references: [id], onDelete: SetNull)

  @@id([roleId, permissionId, scopePolicy])
  @@map("role_permissions")
}

model MembershipRole {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId               String    @map("agency_id") @db.Uuid
  membershipId           String    @map("membership_id") @db.Uuid
  roleId                 String    @map("role_id") @db.Uuid
  effectiveFrom          DateTime  @map("effective_from") @db.Timestamptz(6)
  effectiveTo            DateTime? @map("effective_to") @db.Timestamptz(6)
  assignedByMembershipId String?   @map("assigned_by_membership_id") @db.Uuid
  reason                 String?
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  agency               Agency            @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  membership           AgencyMembership  @relation("MembershipRoleMembership", fields: [agencyId, membershipId], references: [agencyId, id], onDelete: Restrict)
  role                 Role              @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedByMembership AgencyMembership? @relation("MembershipRoleAssigner", fields: [agencyId, assignedByMembershipId], references: [agencyId, id], onDelete: Restrict)

  @@index([agencyId, membershipId, roleId, effectiveFrom, effectiveTo])
  @@map("membership_roles")
}

model DelegatedAuthority {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId              String   @map("agency_id") @db.Uuid
  delegatorMembershipId String   @map("delegator_membership_id") @db.Uuid
  delegateMembershipId  String   @map("delegate_membership_id") @db.Uuid
  permissionCode        String   @map("permission_code") @db.Citext
  organizationUnitId    String?  @map("organization_unit_id") @db.Uuid
  effectiveFrom         DateTime @map("effective_from") @db.Timestamptz(6)
  effectiveTo           DateTime @map("effective_to") @db.Timestamptz(6)
  status                String
  authorityDocumentId   String?  @map("authority_document_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  agency                   Agency             @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  delegator                AgencyMembership   @relation("DelegationDelegator", fields: [agencyId, delegatorMembershipId], references: [agencyId, id], onDelete: Restrict)
  delegate                 AgencyMembership   @relation("DelegationDelegate", fields: [agencyId, delegateMembershipId], references: [agencyId, id], onDelete: Restrict)
  permission               Permission         @relation(fields: [permissionCode], references: [code], onDelete: Restrict)
  personnelActionApprovals PersonnelAction[]  @relation("PersonnelActionApprovalDelegation")
  approvalDecisions        ApprovalDecision[] @relation("ApprovalDecisionDelegation")

  @@unique([agencyId, id])
  @@index([agencyId, delegateMembershipId, effectiveFrom, effectiveTo])
  @@map("delegated_authorities")
}

model UserSession {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  agencyId              String    @map("agency_id") @db.Uuid
  agencyMembershipId    String    @map("agency_membership_id") @db.Uuid
