  shown                 Boolean          @default(true)
  changedAt             DateTime         @default(now()) @map("changed_at") @db.Timestamptz(6)
  changedByName         String           @map("changed_by_name")
  changedByUserId       String           @map("changed_by_user_id") @db.Uuid
  changedByMembershipId String           @map("changed_by_membership_id") @db.Uuid
  agency                Agency           @relation(fields: [agencyId], references: [id], onDelete: Restrict)
