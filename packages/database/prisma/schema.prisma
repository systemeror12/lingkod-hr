model AgencyProfileVersion {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId                 String    @map("agency_id") @db.Uuid
  versionNo                Int       @map("version_no")
  officialName             String    @map("official_name")
  acronym                  String?
  agencyType               String    @default("NGA") @map("agency_type")
  parentOrganization       String?   @map("parent_organization")
  reportingIdentifiers     String?   @map("reporting_identifiers")
  appointingAuthorityTitle String?   @map("appointing_authority_title")
  defaultTimezone          String    @default("Asia/Manila") @map("default_timezone")
  defaultCurrency          String    @default("PHP") @map("default_currency") @db.Char(3)
  deploymentProfile        String    @map("deployment_profile")
  effectiveFrom            DateTime  @map("effective_from") @db.Date
  effectiveTo              DateTime? @map("effective_to") @db.Date
  configuration            Json      @default("{}")
  status                   String
  domainStatus             String    @default("ACTIVE") @map("domain_status")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  agency             Agency   @relation("AgencyProfiles", fields: [agencyId], references: [id], onDelete: Restrict)
  currentForAgencies Agency[] @relation("AgencyCurrentProfile")

  @@unique([agencyId, versionNo])
  @@unique([agencyId, id])
  @@index([agencyId, effectiveFrom])
  @@map("agency_profile_versions")
}

model OrganizationUnit {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId         String   @map("agency_id") @db.Uuid
  code             String   @db.Citext
  unitType         String   @map("unit_type")
  status           String
  currentVersionId String?  @map("current_version_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  agency                    Agency                     @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  currentVersion            OrganizationUnitVersion?   @relation("OrganizationUnitCurrentVersion", fields: [agencyId, currentVersionId], references: [agencyId, id], onDelete: Restrict)
  versions                  OrganizationUnitVersion[]  @relation("OrganizationUnitVersions")
  childVersions             OrganizationUnitVersion[]  @relation("OrganizationUnitVersionParent")
  primaryMemberships        AgencyMembership[]         @relation("AgencyMembershipPrimaryUnit")
  plantillaPositionVersions PlantillaPositionVersion[] @relation("PlantillaPositionOrganizationUnit")
  serviceSegments           ServiceSegment[]           @relation("ServiceSegmentOrganizationUnit")
  personnelBaselines        PersonnelBaseline[]        @relation("PersonnelBaselineOrganizationUnit")
  personnelActionTargets    PersonnelActionVersion[]   @relation("PersonnelActionTargetOrganizationUnit")
  requestsToFill            RequestToFill[]            @relation("RequestToFillRequestingUnit")

  @@unique([agencyId, id])
  @@unique([agencyId, code])
  @@map("organization_units")
}

model OrganizationUnitVersion {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId                 String    @map("agency_id") @db.Uuid
  organizationUnitId       String    @map("organization_unit_id") @db.Uuid
  versionNo                Int       @map("version_no")
  name                     String
  parentUnitId             String?   @map("parent_unit_id") @db.Uuid
  headPositionId           String?   @map("head_position_id") @db.Uuid
  costCenterCode           String?   @map("cost_center_code")
  responsibilityCenterCode String?   @map("responsibility_center_code")
  effectiveFrom            DateTime  @map("effective_from") @db.Date
  effectiveTo              DateTime? @map("effective_to") @db.Date
  status                   String
  domainStatus             String    @default("ACTIVE") @map("domain_status")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  agency           Agency             @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  organizationUnit OrganizationUnit   @relation("OrganizationUnitVersions", fields: [agencyId, organizationUnitId], references: [agencyId, id], onDelete: Restrict)
  currentForUnits  OrganizationUnit[] @relation("OrganizationUnitCurrentVersion")
  parentUnit       OrganizationUnit?  @relation("OrganizationUnitVersionParent", fields: [agencyId, parentUnitId], references: [agencyId, id], onDelete: Restrict)
  headPosition     PlantillaPosition? @relation("OrganizationUnitHead", fields: [agencyId, headPositionId], references: [agencyId, id], onDelete: Restrict)

  @@unique([organizationUnitId, versionNo])
  @@unique([agencyId, id])
  @@index([agencyId, parentUnitId, effectiveFrom])
  @@map("organization_unit_versions")
}

model User {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identityProvider String?   @map("identity_provider")
  externalSubject  String?   @map("external_subject")
  emailNormalized  String    @map("email_normalized") @db.Citext
  displayName      String    @map("display_name")
  globalStatus     String    @map("global_status")
  emailVerifiedAt  DateTime? @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships            AgencyMembership[]
  identityLinks          ExternalIdentityLink[]
  sessions               UserSession[]
  securityEvents         SecurityEvent[]         @relation("SecurityEventUser")
  auditEvents            AuditEvent[]            @relation("AuditEventUser")
  password               UserPassword?
  totpFactor             UserTotpFactor?
  recoveryCodes          UserRecoveryCode[]
  pendingAuthentications PendingAuthentication[]
  passwordResetTokens    PasswordResetToken[]
  changedSeals           AgencySeal[]
  changedBuildingPhotos  AgencyBuildingPhoto[]

  @@unique([identityProvider, externalSubject])
  @@unique([emailNormalized])
  @@map("users")
}

model ExternalIdentityLink {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  issuer       String
  subject      String
  status       String
  linkedAt     DateTime  @default(now()) @map("linked_at") @db.Timestamptz(6)
  supersededAt DateTime? @map("superseded_at") @db.Timestamptz(6)
  reason       String?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([issuer, subject])
  @@index([userId, status])
  @@map("external_identity_links")
}

model AgencyMembership {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId                  String    @map("agency_id") @db.Uuid
  userId                    String    @map("user_id") @db.Uuid
