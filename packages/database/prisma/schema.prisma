model LeaveCancellation {
  id                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId                   String    @map("agency_id") @db.Uuid
  leaveApplicationId         String    @map("leave_application_id") @db.Uuid
  leaveApplicationVersionId  String    @map("leave_application_version_id") @db.Uuid
  priorStatus                String    @map("prior_status")
  scopeType                  String    @map("scope_type")
  reason                     String
  approvalRouteVersionId     String    @map("approval_route_version_id") @db.Uuid
  approvalRequestId          String    @map("approval_request_id") @db.Uuid
  decisionStatus             String    @map("decision_status")
  effectStatus               String    @map("effect_status")
  requestedByMembershipId    String    @map("requested_by_membership_id") @db.Uuid
  requestedAt                DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  lastEffectFailureCode      String?   @map("last_effect_failure_code") @db.Citext
  lastEffectFailureKind      String?   @map("last_effect_failure_kind")

  agency                 Agency                    @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  leaveApplication       LeaveApplication          @relation(fields: [agencyId, leaveApplicationId], references: [agencyId, id], onDelete: Restrict)
  leaveApplicationVersion LeaveApplicationVersion  @relation(fields: [agencyId, leaveApplicationId, leaveApplicationVersionId], references: [agencyId, leaveApplicationId, id], onDelete: Restrict)
  approvalRouteVersion   ApprovalRouteVersion      @relation("LeaveCancellationApprovalRoute", fields: [agencyId, approvalRouteVersionId], references: [agencyId, id], onDelete: Restrict)
  approvalRequest        ApprovalRequest           @relation("LeaveCancellationApprovalRequest", fields: [agencyId, approvalRequestId], references: [agencyId, id], onDelete: Restrict)
  requestedBy            AgencyMembership          @relation("LeaveCancellationRequester", fields: [agencyId, requestedByMembershipId], references: [agencyId, id], onDelete: Restrict)
  documents              LeaveCancellationDocument[]
  effects                LeaveCancellationEffect[]
  scopes                 LeaveCancellationScope[]

  @@unique([approvalRequestId])
  @@unique([agencyId, id])
  @@index([agencyId, leaveApplicationId])
  @@map("leave_cancellations")
}

