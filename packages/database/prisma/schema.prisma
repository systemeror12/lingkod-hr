/// The Agency's current official seal. Bytes stay private in object storage; changes are audited.
model AgencySeal {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId              String           @unique @map("agency_id") @db.Uuid
  objectKey             String           @unique @map("object_key")
  fileName              String           @map("file_name")
  contentType           String           @map("content_type")
  byteSize              Int              @map("byte_size")
  width                 Int
  height                Int
  contentHash           String           @map("content_hash")
  changedAt             DateTime         @default(now()) @map("changed_at") @db.Timestamptz(6)
  changedByName         String           @map("changed_by_name")
  changedByUserId       String           @map("changed_by_user_id") @db.Uuid
  changedByMembershipId String           @map("changed_by_membership_id") @db.Uuid
  agency                Agency           @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  changedByUser         User             @relation(fields: [changedByUserId], references: [id], onDelete: Restrict)
  changedByMembership   AgencyMembership @relation(fields: [agencyId, changedByMembershipId], references: [agencyId, id], onDelete: Restrict)

  @@map("agency_seals")
}

/// The Agency's current building photo for Invitation Activation. Kept but not shown while `shown` is false.
model AgencyBuildingPhoto {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId              String           @unique @map("agency_id") @db.Uuid
