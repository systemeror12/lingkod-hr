  lockedAttendanceAdjustments   LockedAttendanceAdjustment[]
  lockedAttendanceAdjustmentPeriods LockedAttendanceAdjustmentPeriod[]
  dtrDocuments                  DtrDocument[]
  attendancePayrollPublications AttendancePayrollPublication[]
