  initiatedAttendanceCorrections         AttendanceCorrection[]             @relation("AttendanceCorrectionInitiator")
  recordedAttendanceCorrections          AttendanceCorrection[]             @relation("AttendanceCorrectionRecorder")
  decidedAttendanceCorrections           AttendanceCorrection[]             @relation("AttendanceCorrectionDecider")
