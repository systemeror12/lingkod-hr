generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

model Agency {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                    String   @unique @db.Citext
  name                    String
  acronym                 String?
  agencyType              String   @map("agency_type")
  status                  String
  defaultTimezone         String   @default("Asia/Manila") @map("default_timezone")
  defaultCurrency         String   @default("PHP") @map("default_currency") @db.Char(3)
  currentProfileVersionId String?  @map("current_profile_version_id") @db.Uuid
  rowVersion              Int      @default(1) @map("row_version")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  currentProfile                AgencyProfileVersion?              @relation("AgencyCurrentProfile", fields: [id, currentProfileVersionId], references: [agencyId, id], onDelete: Restrict, map: "agencies_current_profile_fkey")
  seal                          AgencySeal?
  buildingPhoto                 AgencyBuildingPhoto?
  profiles                      AgencyProfileVersion[]             @relation("AgencyProfiles")
  memberships                   AgencyMembership[]
  invitations                   Invitation[]
  roles                         Role[]
  membershipRoles               MembershipRole[]
  delegatedAuthorities          DelegatedAuthority[]
  sessions                      UserSession[]
  securityEvents                SecurityEvent[]
  auditEvents                   AuditEvent[]
  governmentIdentifiers         GovernmentIdentifier[]
  payrollBankAccounts           PayrollBankAccount[]
  salnComplianceRecords         SalnComplianceRecord[]
  organizationUnits             OrganizationUnit[]
  organizationUnitVersions      OrganizationUnitVersion[]
  documents                     Document[]
  documentVersions              DocumentVersion[]
  staffingAuthorities           StaffingAuthority[]
  qualificationStandards        QualificationStandard[]
  qualificationStandardVersions QualificationStandardVersion[]
  plantillaPositions            PlantillaPosition[]
  appointmentAgencySetting      AppointmentAgencySettings?
  appointments                  Appointment[]
  appointmentVersions           AppointmentVersion[]
  appointmentEvidenceLinks      AppointmentDocumentVersionLink[]
  appointmentExternalSubmissions AppointmentExternalSubmissionEvent[]
  appointmentExternalActions    AppointmentExternalAction[]
  appointmentAcknowledgments    AppointmentAcknowledgment[]
  oathsOfOffice                 OathOfOffice[]
  oathVersions                  OathVersion[]
  assumptionsToDuty             AssumptionToDuty[]
  assumptionVersions            AssumptionVersion[]
  assumptionOutcomeEvents       AssumptionOutcomeEvent[]
  plantillaPositionVersions     PlantillaPositionVersion[]
  positionDocuments             PositionDocument[]
  employees                     Employee[]
  employeeDocuments             EmployeeDocument[]
  pdsVersions                   PdsVersion[]
  pdsPersonalDetails            PdsPersonalDetails[]
  pdsFamilyRecords              PdsFamilyRecord[]
  pdsEducationRecords           PdsEducationRecord[]
  pdsEligibilityRecords         PdsEligibilityRecord[]
  pdsWorkExperienceRecords      PdsWorkExperienceRecord[]
  pdsVoluntaryWorkRecords       PdsVoluntaryWorkRecord[]
  pdsLearningDevelopmentRecords PdsLearningDevelopmentRecord[]
  pdsWesArtifacts               PdsWesArtifact[]
  pdsWesEntries                 PdsWesEntry[]
  pdsOtherInformation           PdsOtherInformation[]
  pdsDeclarationDetails         PdsDeclarationDetails[]
  pdsReferenceRecords           PdsReferenceRecord[]
  pdsCertificationDetails       PdsCertificationDetails[]
  pdsPageSignatures             PdsPageSignature[]
  pdsTransitionEvents           PdsTransitionEvent[]
  pdsOutputArtifacts            PdsOutputArtifact[]
  personnelBaselines            PersonnelBaseline[]
  personnelActions              PersonnelAction[]
  personnelActionVersions       PersonnelActionVersion[]
  personnelActionEvidence       PersonnelActionEvidence[]
  serviceSegments               ServiceSegment[]
  positionIncumbencies          PositionIncumbency[]
  separationCases               SeparationCase[]
  separationEffects             SeparationEffect[]
  serviceRecordSnapshots        ServiceRecordSnapshot[]
  outboxEvents                  OutboxEvent[]
  leavePostings                 LeavePosting[]
