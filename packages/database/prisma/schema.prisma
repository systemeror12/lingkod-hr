/// A pending sign-in (5 minutes) or pending activation (15 minutes), held by an HTTP-only cookie
/// whose token is stored only as `tokenHash`.
model PendingAuthentication {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash                Bytes    @unique @map("token_hash")
  purpose                  String
  userId                   String?  @map("user_id") @db.Uuid
  invitationId             String?  @map("invitation_id") @db.Uuid
  requestedMembershipId    String?  @map("requested_membership_id") @db.Uuid
  stage                    String
  verifiedMethods          String[] @default([]) @map("verified_methods")
  displayName              String?  @map("display_name")
  passwordHash             String?  @map("password_hash")
  enrollmentSecretEnvelope Bytes?   @map("enrollment_secret_envelope")
  recoveryCodeHashes       String[] @default([]) @map("recovery_code_hashes")
  enrollmentAcceptedStep   BigInt?  @map("enrollment_accepted_step")
  expiresAt                DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitation Invitation? @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@map("pending_authentications")
}

/// A password reset link. Only the SHA-256 hash of its token is kept; a row ends once, by being
/// consumed or superseded, and stays to tell a later attempt why the link no longer works.
model PasswordResetToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    Bytes     @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(6)
  supersededAt DateTime? @map("superseded_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

/// The Sign-in Cool-down ladder for one keyed email hash; see `@lingkod-hr/auth` sign-in-cooldown.
model SignInThrottle {
  emailHash     Bytes     @id @map("email_hash")
  failureCount  Int       @default(0) @map("failure_count")
  cooldownLevel Int       @default(0) @map("cooldown_level")
  cooldownUntil DateTime? @map("cooldown_until") @db.Timestamptz(6)
  lastFailureAt DateTime  @map("last_failure_at") @db.Timestamptz(6)

  @@map("sign_in_throttles")
}

