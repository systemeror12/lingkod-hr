{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "APP_ENV",
    "APP_URL",
    "API_URL",
    "API_PORT",
    "WORKER_PORT",
    "DATABASE_URL",
    "DATABASE_DIRECT_URL",
    "DATABASE_E2E",
    "DATABASE_E2E_ADMIN_URL",
    "REDIS_URL",
    "OIDC_ISSUER",
    "OIDC_CLIENT_ID",
    "OIDC_CLIENT_SECRET",
    "OIDC_REDIRECT_URI",
    "SESSION_SECRET",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_BUCKET",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "OPENAI_API_KEY",
    "AI_DEFAULT_MODEL",
    "AI_EMBEDDING_MODEL",
    "AI_FEATURES_ENABLED",
    "EMAIL_FROM",
    "EMAIL_PROVIDER_API_KEY",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "ERROR_TRACKING_DSN",
    "DATA_ENCRYPTION_KEY",
    "BLIND_INDEX_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "dependsOn": ["^build"],
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "cache": false,
      "outputs": []
    }
  }
}
