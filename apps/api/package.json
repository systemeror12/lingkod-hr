{
  "name": "@lingkod-hr/api",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint .",
    "provision:agency": "tsx src/agency-provisioning/provision-agency.ts",
    "start": "node dist/main.js",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "vitest run --passWithNoTests",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=4096 tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@lingkod-hr/auth": "workspace:*",
    "@lingkod-hr/config": "workspace:*",
    "@lingkod-hr/database": "workspace:*",
    "@lingkod-hr/observability": "workspace:*",
    "@nestjs/common": "11.1.29",
    "@nestjs/core": "11.1.29",
    "@nestjs/platform-express": "11.1.29",
    "@prisma/client": "6.19.3",
    "multer": "^2.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/multer": "^2.2.0",
    "tsx": "4.23.12"
  }
}
