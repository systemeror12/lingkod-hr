{
  "name": "@lingkod-hr/web",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "lint": "eslint .",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "test": "vitest run --passWithNoTests --exclude 'e2e/**'",
    "test:e2e": "playwright test",
    "test:e2e:phase3": "playwright test e2e/phase-3.spec.ts --project=chromium",
    "test:e2e:phase5": "playwright test e2e/phase-5.spec.ts --project=chromium",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@lingkod-hr/auth": "workspace:*",
    "@lingkod-hr/config": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.3.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@prisma/client": "6.19.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.12"
  }
}
